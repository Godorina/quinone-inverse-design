# CQ04: In which form does a reduced quinone hold CO2 (adduct, carbonate, carbamate, ...)?
PREFIX qn: <https://w3id.org/quinone#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>

SELECT ?name ?mode ?solvent ?doi WHERE {
  ?o a qn:Observation ; qn:observationKind qn:BindingMode ; qn:outcome ?out ; qn:ofCompound ?compound ; qn:underCondition ?c ; qn:fromPaper ?paper .
  ?compound schema:name ?name .
  ?paper schema:identifier ?doi .
  ?out skos:prefLabel ?mode . FILTER(lang(?mode) = "en")
  ?c qn:solvent ?sv .
  ?sv skos:prefLabel ?solvent . FILTER(lang(?solvent) = "en")
} ORDER BY ?mode ?name
